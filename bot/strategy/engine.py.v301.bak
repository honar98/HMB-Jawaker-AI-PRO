import math

from bot.indicators.aggregator import analyze_market


def _signal_from_market(market):
    trend = market["trend"]
    rsi = market["rsi"]
    macd = market["macd"]
    macd_signal = market["macd_signal"]
    histogram = market["macd_histogram"]
    atr = market["atr"]

    values = (market["price"], rsi, macd, macd_signal, histogram, atr)
    if not all(math.isfinite(float(v)) for v in values) or atr <= 0:
        return {**market, "action": "WAIT", "score": 50, "reasons": ["Insufficient indicator data"]}

    score = 50
    reasons = []

    if trend == "bullish":
        score += 20
        reasons.append("Bullish EMA trend")
    elif trend == "bearish":
        score -= 20
        reasons.append("Bearish EMA trend")

    if macd > macd_signal and histogram > 0:
        score += 15
        reasons.append("MACD bullish confirmation")
    elif macd < macd_signal and histogram < 0:
        score -= 15
        reasons.append("MACD bearish confirmation")

    if 60 <= rsi <= 68:
        score += 15
        reasons.append("Bullish RSI momentum")
    elif 32 <= rsi <= 40:
        score -= 15
        reasons.append("Bearish RSI momentum")

    score = max(0, min(100, score))

    buy_ok = trend == "bullish" and 60 <= rsi <= 68 and macd > macd_signal and histogram > 0 and score >= 85
    sell_ok = trend == "bearish" and 32 <= rsi <= 40 and macd < macd_signal and histogram < 0 and score <= 15

    action = "BUY" if buy_ok else "SELL" if sell_ok else "WAIT"
    return {**market, "action": action, "score": score, "reasons": reasons}


def generate_signal(high, low, close):
    return _signal_from_market(analyze_market(high, low, close))
